# Copy this file to .env and fill in the values.

# Your local PostgreSQL. Create the database first:  createdb -U postgres bookinglog
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/bookinglog

PORT=4000

# Long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Sent as the x-admin-key header on /admin routes (you, the software provider).
ADMIN_API_KEY=change-me-too

# Optional. The defaults suit most cases.
# Proxies in front of the server, so it sees each caller's real IP address.
# 0 locally; defaults to 1 on Railway.
#TRUST_PROXY=0
# Most requests one IP address may make per minute.
#RATE_LIMIT_PER_MINUTE=300
# Most database connections this server opens at once.
#DB_POOL_MAX=10
# Set to false to stop printing one line per request.
#LOG_REQUESTS=true
