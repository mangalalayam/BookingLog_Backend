# Copy this file to .env and fill in the values.

# Your local PostgreSQL. Create the database first:  createdb -U postgres bookinglog
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/bookinglog

PORT=4000

# Long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Sent as the x-admin-key header on /admin routes (you, the software provider).
ADMIN_API_KEY=change-me-too
